{
  "name": "styleguide",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "A visual styleguide of the editor's UI components.",
  "keywords": [
    "component",
    "reference",
    "showcase",
    "design-system",
    "package-dev"
  ],
  "repository": "https://github.com/lumine-code/styleguide",
  "bugs": {
    "url": "https://github.com/lumine-code/styleguide/issues"
  },
  "license": "MIT",
  "main": "./lib/styleguide",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "StyleguideView": "createStyleguideView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#730d47e10f6d655c010f2880186a3a60ed0c73b0",
    "dedent": "^1.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
