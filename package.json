{
  "name": "styleguide",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "A visual styleguide of the editor's UI components.",
  "keywords": [
    "component",
    "reference",
    "showcase",
    "design-system",
    "package-dev"
  ],
  "repository": "https://github.com/lumine-code/styleguide",
  "bugs": {
    "url": "https://github.com/lumine-code/styleguide/issues"
  },
  "license": "MIT",
  "main": "./lib/styleguide",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "StyleguideView": "createStyleguideView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#6a70cf13538fec87811032283d1d10f93d975b5c",
    "dedent": "^1.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    }
  }
}
